{% extends "fretes/base.html" %}
{% block title %}{% if is_new %}Nova{% else %}Editar{% endif %} Garantia{% endblock %}
{% block content %}
<div class="container" style="max-width: 800px;">
  <h5 class="mb-3">{% if is_new %}Nova{% else %}Editar{% endif %} Garantia</h5>
  <form method="post" novalidate>
    {% csrf_token %}

    <div class="row mb-3">
      <label class="col-sm-3 col-form-label">{{ form.cliente.label }}</label>
      <div class="col-sm-9">{{ form.cliente }}</div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-3 col-form-label">{{ form.codigo_peca.label }}</label>
      <div class="col-sm-9">
        <input
          type="text"
          name="codigo_peca"
          id="id_codigo_peca"
          class="form-control"
          value="{{ form.codigo_peca.value|default:'' }}"
          list="produtos-datalist"
          hx-get="{% url 'fretes:produtos_autocomplete' %}"
          hx-trigger="keyup changed delay:200ms"
          hx-target="#produtos-datalist"
          hx-swap="outerHTML"
          hx-include="[name='codigo_peca']"
        >
        <datalist id="produtos-datalist"></datalist>
      </div>
    </div>

    <div class="row mb-3" id="descricao-container"
         hx-get="{% url 'fretes:produto_descricao' %}"
         hx-trigger="load, keyup from:#id_codigo_peca changed from:#id_codigo_peca delay:200ms"
         hx-target="#descricao-container"
         hx-swap="outerHTML"
         hx-include="#id_codigo_peca">
      <label class="col-sm-3 col-form-label">Descrição do produto</label>
      <div class="col-sm-9">
        {% include 'fretes/_produto_descricao.html' with descricao='' %}
      </div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-3 col-form-label">{{ form.numero_lote.label }}</label>
      <div class="col-sm-9">{{ form.numero_lote }}</div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-3 col-form-label">{{ form.defeito.label }}</label>
      <div class="col-sm-9">{{ form.defeito }}</div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-3 col-form-label">{{ form.nota_recebida.label }}</label>
      <div class="col-sm-9">{{ form.nota_recebida }}</div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-3 col-form-label">{{ form.valor.label }}</label>
      <div class="col-sm-9">{{ form.valor }}</div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-3 col-form-label">{{ form.data_recebimento.label }}</label>
      <div class="col-sm-9">{{ form.data_recebimento }}</div>
    </div>

    <div class="row mb-3">
      <label class="col-sm-3 col-form-label">{{ form.nota_retorno.label }}</label>
      <div class="col-sm-9">{{ form.nota_retorno }}</div>
    </div>

    <div class="row mb-4">
      <label class="col-sm-3 col-form-label">{{ form.data_retorno.label }}</label>
      <div class="col-sm-9">{{ form.data_retorno }}</div>
    </div>

    <div class="d-flex gap-2">
      <button class="btn btn-primary" type="submit">Salvar</button>
      <a class="btn btn-outline-secondary" href="{% url 'fretes:garantia_list' %}">Voltar</a>
    </div>
  </form>
</div>
{% endblock %}
